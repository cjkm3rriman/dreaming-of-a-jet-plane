# Live Flight Providers
LIVE_AIRCRAFT_PROVIDER=fr24  # Primary provider key (fr24 or airlabs)
LIVE_AIRCRAFT_PROVIDER_FALLBACKS=airlabs  # Comma-separated fallback providers
PROVIDER_OVERRIDE_SECRET=your_provider_override_secret
FR24_API_KEY=your_flightradar24_api_key_here
AIRLABS_API_KEY=your_airlabs_api_key_here
# AIRLABS_BASE_URL=https://airlabs.co/api/v9  # Override the Airlabs API base (optional)
# AIRLABS_MAX_SIGNAL_AGE_SECONDS=300  # Drop aircraft whose last signal is older than this (DOJP-37)

# TTS Provider Configuration
TTS_PROVIDER=elevenlabs  # Options: elevenlabs, google, inworld (each is a single voice; no cross-provider fallback)
ELEVENLABS_TEXT_TO_VOICE_API_KEY=your_elevenlabs_api_key_here

# Inworld TTS (production provider). Voice/model/encoding have code defaults;
# override here only to change them. INWORLD_API_KEY_PREENCODED forces how the
# key is interpreted (true = already base64, false = raw); leave unset to auto-detect.
INWORLD_API_KEY=your_inworld_api_key_here
# INWORLD_VOICE_ID=Ronald
# INWORLD_MODEL_ID=inworld-tts-1.5-mini
# INWORLD_AUDIO_ENCODING=OGG_OPUS
# INWORLD_API_KEY_PREENCODED=true

# Provider Override (for testing both aircraft and TTS providers via query parameters)
# Generate a secure secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Uses PROVIDER_OVERRIDE_SECRET defined above

# Optional Analytics & Monitoring
MIXPANEL_TOKEN=your_mixpanel_project_token_here
# SENTRY_DSN=your_sentry_dsn_here  # Error monitoring; env auto-detected from RAILWAY_REPLICA_ID

# IP Geolocation (optional; unauthenticated ipapi.co is used when unset)
# IPAPI_API_KEY=your_ipapi_key_here

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# S3 Caching (optional)
S3_BUCKET_NAME=your_s3_bucket_name
AWS_S3_REGION=us-east-2  # Region for S3 bucket

# Google Gemini TTS Configuration (if using google provider)
GOOGLE_API_KEY=your_google_api_key_here
